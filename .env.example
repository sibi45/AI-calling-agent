# ==============================================================================
# CONNECTHUB PULSE VIRTUAL NUMBER & TELEPHONY CONFIGURATION
# ==============================================================================
PULSE_AUTH_URL=https://connecthub.pulsework360.com/auth/token
PULSE_C2C_URL=https://jxoclvto1l.execute-api.ap-south-1.amazonaws.com/v1/
PULSE_ACCOUNT_CODE=your_pulse_account_code_here
PULSE_MEMBER_NAME=your_pulse_member_name_here
PULSE_MEMBER_PASSWORD=your_pulse_member_password_here
PULSE_VIRTUAL_NUMBER=your_pulse_virtual_number_here

# Public Tunnel URL (e.g. ngrok or cloud server domain for Pulse WebSockets)
PUBLIC_BASE_URL=https://your-ngrok-or-domain.ngrok-free.dev
PORT=8080

# ==============================================================================
# AI MODEL CONFIGURATIONS & API KEYS
# ==============================================================================

# --- 1. SPEECH-TO-TEXT (STT) ---
# Option A: Groq Whisper (100% Free Tier, ultra-fast ~180ms TTFB)
GROQ_API_KEY=your_groq_api_key_here

# Option B: Deepgram (streaming STT for telephony)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Option C: Useful Sensors Moonshine (100% Free & Local ONNX STT)
# Set to true to force offline Moonshine STT even if cloud keys are present
USE_LOCAL_STT=false

# --- 2. LARGE LANGUAGE MODEL (LLM) ---
# Option A: Google Gemini (Gemini 3.1 Flash-Lite)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=128

# Option B: OpenAI (GPT-4o or GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Option C: Groq LLaMA
# GROQ_API_KEY above is also used for LLaMA 3.3 70B if selected

# --- 3. TEXT-TO-SPEECH (TTS) ---
# Option A: Kokoro-82M (100% Free & Local ONNX neural voice, <100ms)
# Set to true to use local Kokoro TTS; set to false to use Cartesia or ElevenLabs
USE_KOKORO=true

# Option B: Cartesia (Ultra-fast cloud TTS, ~100ms latency)
CARTESIA_API_KEY=your_cartesia_api_key_here

# Option C: ElevenLabs (Expressive voices)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
